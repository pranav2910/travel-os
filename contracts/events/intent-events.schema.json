{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.travelos.io/events/intent-events.schema.json",
  "title": "IntentEvents",
  "description": "Data payloads for topic travel.intent: what the platform concluded about a traveler's need, and the model-call evidence behind it.",
  "$defs": {
    "intent": {
      "type": "object",
      "required": [
        "origin",
        "destination",
        "earliestDeparture",
        "arrivalDeadline",
        "hotelRequired",
        "travelers"
      ],
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "destination": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "earliestDeparture": {
          "type": "string",
          "format": "date-time"
        },
        "arrivalDeadline": {
          "type": "string",
          "format": "date-time"
        },
        "returnAfter": {
          "type": "string",
          "format": "date-time"
        },
        "latestReturn": {
          "type": "string",
          "format": "date-time"
        },
        "purpose": {
          "type": "string",
          "maxLength": 500
        },
        "hotelRequired": {
          "type": "boolean"
        },
        "travelers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "itinerary": {
          "type": "object",
          "description": "Slice 3: legs, stays, transfers with component ids (see trip.proto Itinerary)"
        }
      }
    },
    "modelCallId": {
      "type": "string",
      "pattern": "^llm_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "travel.intent.detected": {
      "type": "object",
      "required": [
        "tripId",
        "method",
        "result",
        "model",
        "modelCallId",
        "confidence",
        "intent"
      ],
      "additionalProperties": false,
      "properties": {
        "tripId": {
          "$ref": "common.schema.json#/$defs/tripId"
        },
        "method": {
          "enum": [
            "FREE_TEXT",
            "CALENDAR",
            "EMAIL"
          ]
        },
        "result": {
          "const": "EXTRACTED"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "modelCallId": {
          "$ref": "#/$defs/modelCallId"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "intent": {
          "$ref": "#/$defs/intent"
        },
        "detectedBy": {
          "$ref": "common.schema.json#/$defs/principal"
        }
      }
    },
    "travel.intent.rejected": {
      "type": "object",
      "required": [
        "tripId",
        "method",
        "result",
        "model",
        "modelCallId"
      ],
      "additionalProperties": false,
      "properties": {
        "tripId": {
          "$ref": "common.schema.json#/$defs/tripId"
        },
        "method": {
          "enum": [
            "FREE_TEXT",
            "CALENDAR",
            "EMAIL"
          ]
        },
        "result": {
          "enum": [
            "NEEDS_CLARIFICATION",
            "NOT_A_TRAVEL_REQUEST"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "modelCallId": {
          "$ref": "#/$defs/modelCallId"
        },
        "missingFields": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "clarifyingQuestion": {
          "type": "string",
          "maxLength": 500
        },
        "detectedBy": {
          "$ref": "common.schema.json#/$defs/principal"
        }
      }
    }
  }
}
