{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.travelos.io/events/finance-events.schema.json",
  "title": "FinanceEvents",
  "description": "Data payloads for topic travel.finance (Phase 5, ADR-0017): payments on the corporate instrument, what is owed to suppliers, and travel credits. Amounts are integer minor units in an explicit currency; fx records the provider's conversion with its provenance and is never computed by the platform.",
  "$defs": {
    "fx": {
      "type": "object",
      "required": [
        "settlementCurrency",
        "settlementAmountMinor",
        "rate",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "settlementCurrency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "settlementAmountMinor": {
          "type": "integer"
        },
        "rate": {
          "type": "number"
        },
        "source": {
          "type": "string",
          "maxLength": 120
        },
        "quotedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
