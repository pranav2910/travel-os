        },
        "amount": {
          "$ref": "common.schema.json#/$defs/money"
        },
        "status": {
          "enum": [
            "AUTHORIZED",
            "CAPTURED",
            "VOIDED",
            "PARTIALLY_REFUNDED",
            "REFUNDED",
            "DECLINED",
            "FAILED"
          ]
        },
