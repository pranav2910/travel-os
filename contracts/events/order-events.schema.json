{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.travelos.io/events/order-events.schema.json",
  "title": "OrderEvents",
  "description": "Data payloads for topic travel.order. Each $def key is an eventType.",
  "$defs": {
    "orderItem": {
      "type": "object",
      "required": ["itemId", "type", "status"],
      "additionalProperties": false,
      "properties": {
        "itemId": { "type": "string", "pattern": "^itm_[0-9A-HJKMNP-TV-Z]{26}$" },
        "type": { "enum": ["AIR", "HOTEL", "GROUND"] },
        "status": { "enum": ["PENDING", "HELD", "CONFIRMED", "FAILED", "CANCELLED"] },
        "externalRef": { "type": "string" },
        "recordLocator": { "type": "string" }
      }
    },
    "travel.order.created": {
      "type": "object",
      "required": ["orderId", "tripId", "supplier", "status", "total", "idempotencyKey", "items"],
      "additionalProperties": false,
      "properties": {
        "orderId": { "$ref": "common.schema.json#/$defs/orderId" },
        "tripId": { "$ref": "common.schema.json#/$defs/tripId" },
        "supplier": { "type": "string", "minLength": 1 },
        "status": { "const": "CREATING" },
        "total": { "$ref": "common.schema.json#/$defs/money" },
        "idempotencyKey": { "$ref": "common.schema.json#/$defs/idempotencyKey" },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/orderItem" } },
        "policyDecisionId": { "$ref": "common.schema.json#/$defs/policyDecisionId" },
        "optimizationRunId": { "$ref": "common.schema.json#/$defs/optimizationRunId" },
        "approvalId": { "$ref": "common.schema.json#/$defs/approvalId" }
      }
    },
    "travel.order.confirmed": {
      "type": "object",
      "required": ["orderId", "tripId", "supplier", "externalOrderId", "total", "items"],
      "additionalProperties": false,
      "properties": {
        "orderId": { "$ref": "common.schema.json#/$defs/orderId" },
        "tripId": { "$ref": "common.schema.json#/$defs/tripId" },
        "supplier": { "type": "string", "minLength": 1 },
        "externalOrderId": { "type": "string", "minLength": 1 },
        "total": { "$ref": "common.schema.json#/$defs/money" },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/orderItem" } }
      }
    },
    "travel.order.changed": {
      "type": "object",
      "required": ["orderId", "tripId", "incrementalCost", "changedBy"],
      "additionalProperties": false,
      "properties": {
        "orderId": { "$ref": "common.schema.json#/$defs/orderId" },
        "tripId": { "$ref": "common.schema.json#/$defs/tripId" },
        "incrementalCost": { "$ref": "common.schema.json#/$defs/money" },
        "changedBy": { "$ref": "common.schema.json#/$defs/principal" },
        "policyDecisionId": { "$ref": "common.schema.json#/$defs/policyDecisionId" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/orderItem" } }
      }
    },
    "travel.order.cancelled": {
      "type": "object",
      "required": ["orderId", "tripId", "cancelledBy"],
      "additionalProperties": false,
      "properties": {
        "orderId": { "$ref": "common.schema.json#/$defs/orderId" },
        "tripId": { "$ref": "common.schema.json#/$defs/tripId" },
        "refund": { "$ref": "common.schema.json#/$defs/money" },
        "reason": { "type": "string", "maxLength": 1000 },
        "cancelledBy": { "$ref": "common.schema.json#/$defs/principal" }
      }
    },
    "travel.order.failed": {
      "type": "object",
      "required": ["orderId", "tripId", "status", "reasonCode", "compensated"],
      "additionalProperties": false,
      "properties": {
        "orderId": { "$ref": "common.schema.json#/$defs/orderId" },
        "tripId": { "$ref": "common.schema.json#/$defs/tripId" },
        "status": { "enum": ["FAILED", "PARTIALLY_FAILED"] },
        "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "message": { "type": "string", "maxLength": 2000 },
        "compensated": { "type": "boolean", "description": "true when every held/confirmed item was released or cancelled" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/orderItem" } }
      }
    }
  }
}
