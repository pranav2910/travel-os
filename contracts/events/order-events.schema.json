{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.travelos.io/events/order-events.schema.json",
  "title": "OrderEvents",
  "description": "Data payloads for topic travel.order. Each $def key is an eventType.",
  "$defs": {
    "orderItem": {
      "type": "object",
      "required": [
        "itemId",
        "type",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "itemId": {
          "type": "string",
          "pattern": "^itm_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "type": {
          "enum": [
            "AIR",
            "HOTEL",
            "GROUND"
          ]
        },
        "status": {
          "enum": [
            "PENDING",
            "HELD",
            "CONFIRMED",
            "FAILED",
            "CANCELLED",
            "CHANGED",
            "CANCEL_FAILED"
          ]
        },
        "externalRef": {
          "type": "string"
        },
        "recordLocator": {
          "type": "string"
        },
        "componentId": {
          "type": "string",
          "pattern": "^cmp_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "total": {
          "$ref": "common.schema.json#/$defs/money"
        },
        "failureCode": {
          "type": "string"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "supplierKey": {
          "type": "string",
          "pattern": "^(air|hotel|ground):.+$",
          "description": "air:<carrier> | hotel:<property id> | ground:<vendor id>: the supplier an outcome of this item is attributed to (Slice 5)"
        }
      }
    },
    "travel.order.created": {
      "type": "object",
      "required": [
        "orderId",
        "tripId",
        "supplier",
        "status",
        "total",
        "idempotencyKey",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "orderId": {
          "$ref": "common.schema.json#/$defs/orderId"
        },
        "tripId": {
          "$ref": "common.schema.json#/$defs/tripId"
        },
        "supplier": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "CREATING"
        },
        "total": {
          "$ref": "common.schema.json#/$defs/money"
        },
        "idempotencyKey": {
          "$ref": "common.schema.json#/$defs/idempotencyKey"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/orderItem"
          }
        },
        "policyDecisionId": {
          "$ref": "common.schema.json#/$defs/policyDecisionId"
        },
        "optimizationRunId": {
          "$ref": "common.schema.json#/$defs/optimizationRunId"
        },
        "approvalId": {
          "$ref": "common.schema.json#/$defs/approvalId"
        }
      }
    },
    "travel.order.confirmed": {
      "type": "object",
      "required": [
        "orderId",
        "tripId",
        "supplier",
        "externalOrderId",
        "total",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "orderId": {
          "$ref": "common.schema.json#/$defs/orderId"
        },
        "tripId": {
          "$ref": "common.schema.json#/$defs/tripId"
        },
        "supplier": {
          "type": "string",
          "minLength": 1
        },
        "externalOrderId": {
          "type": "string",
          "minLength": 1
        },
        "total": {
          "$ref": "common.schema.json#/$defs/money"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/orderItem"
          }
        }
      }
    },
    "travel.order.changed": {
      "type": "object",
      "required": [
        "orderId",
        "tripId",
        "incrementalCost",
        "changedBy"
      ],
      "additionalProperties": false,
      "properties": {
        "orderId": {
          "$ref": "common.schema.json#/$defs/orderId"
        },
        "tripId": {
          "$ref": "common.schema.json#/$defs/tripId"
        },
        "incrementalCost": {
          "$ref": "common.schema.json#/$defs/money"
        },
        "changedBy": {
          "$ref": "common.schema.json#/$defs/principal"
        },
        "policyDecisionId": {
          "$ref": "common.schema.json#/$defs/policyDecisionId"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/orderItem"
          }
        },
        "disruptionId": {
          "type": "string",
          "pattern": "^dsr_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "changeId": {
          "type": "string",
          "pattern": "^chg_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "previousBundleId": {
          "$ref": "common.schema.json#/$defs/bundleId"
        },
        "replacementBundleId": {
          "$ref": "common.schema.json#/$defs/bundleId"
        },
        "optimizationRunId": {
          "$ref": "common.schema.json#/$defs/optimizationRunId"
        },
        "approvalId": {
          "$ref": "common.schema.json#/$defs/approvalId"
        },
        "externalOrderId": {
          "type": "string"
        },
        "recordLocator": {
          "type": "string"
        },
        "total": {
          "$ref": "common.schema.json#/$defs/money"
        }
      }
    },
    "travel.order.cancelled": {
      "type": "object",
      "required": [
        "orderId",
        "tripId",
        "cancelledBy"
      ],
      "additionalProperties": false,
      "properties": {
        "orderId": {
          "$ref": "common.schema.json#/$defs/orderId"
        },
        "tripId": {
          "$ref": "common.schema.json#/$defs/tripId"
        },
        "refund": {
          "$ref": "common.schema.json#/$defs/money"
        },
        "reason": {
          "type": "string",
          "maxLength": 1000
        },
        "cancelledBy": {
          "$ref": "common.schema.json#/$defs/principal"
        }
      }
    },
    "travel.order.failed": {
      "type": "object",
      "required": [
        "orderId",
        "tripId",
        "status",
        "reasonCode",
        "compensated"
      ],
      "additionalProperties": false,
      "properties": {
        "orderId": {
          "$ref": "common.schema.json#/$defs/orderId"
        },
        "tripId": {
          "$ref": "common.schema.json#/$defs/tripId"
        },
        "status": {
          "enum": [
            "FAILED",
            "PARTIALLY_FAILED"
          ]
        },
        "reasonCode": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message": {
          "type": "string",
          "maxLength": 2000
        },
        "compensated": {
          "type": "boolean",
          "description": "true when every held/confirmed item was released or cancelled"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/orderItem"
          }
        },
        "exposures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exposure"
          }
        }
      }
    },
    "travel.order.change-requested": {
      "type": "object",
      "required": [
        "orderId",
        "tripId",
        "disruptionId",
        "changeId",
        "idempotencyKey",
        "previousBundleId",
        "replacementBundleId",
        "requestedBy"
      ],
      "additionalProperties": false,
      "properties": {
        "orderId": {
          "$ref": "common.schema.json#/$defs/orderId"
        },
        "tripId": {
          "$ref": "common.schema.json#/$defs/tripId"
        },
        "disruptionId": {
          "type": "string",
          "pattern": "^dsr_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "changeId": {
          "type": "string",
          "pattern": "^chg_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "previousBundleId": {
          "$ref": "common.schema.json#/$defs/bundleId"
        },
        "replacementBundleId": {
          "$ref": "common.schema.json#/$defs/bundleId"
        },
        "policyDecisionId": {
          "$ref": "common.schema.json#/$defs/policyDecisionId"
        },
        "optimizationRunId": {
          "$ref": "common.schema.json#/$defs/optimizationRunId"
        },
        "approvalId": {
          "$ref": "common.schema.json#/$defs/approvalId"
        },
        "requestedBy": {
          "$ref": "common.schema.json#/$defs/principal"
        }
      }
    },
    "exposure": {
      "type": "object",
      "required": [
        "exposureId",
        "itemId",
        "provider",
        "externalRef",
        "amount",
        "reason",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "exposureId": {
          "type": "string",
          "pattern": "^exp_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "itemId": {
          "type": "string",
          "pattern": "^itm_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "componentId": {
          "type": "string",
          "pattern": "^cmp_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "provider": {
          "type": "string"
        },
        "externalRef": {
          "type": "string"
        },
        "amount": {
          "$ref": "common.schema.json#/$defs/money"
        },
        "reason": {
          "enum": [
            "COMPENSATION_FAILED",
            "NON_REFUNDABLE"
          ]
        },
        "detail": {
          "type": "string",
          "maxLength": 2000
        },
        "status": {
          "enum": [
            "OPEN",
            "RESOLVED"
          ]
        }
      }
    },
    "travel.order.compensation-failed": {
      "type": "object",
      "required": [
        "orderId",
        "tripId",
        "exposures"
      ],
      "additionalProperties": false,
      "description": "Slice 3: a confirmed component could not be released after a later component failed; the money at risk is recorded and a person must act.",
      "properties": {
        "orderId": {
          "$ref": "common.schema.json#/$defs/orderId"
        },
        "tripId": {
          "$ref": "common.schema.json#/$defs/tripId"
        },
        "reasonCode": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message": {
          "type": "string",
          "maxLength": 2000
        },
        "exposures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/exposure"
          }
        },
        "requiredRole": {
          "enum": [
            "TRAVEL_ADMIN",
            "FINANCE"
          ]
        }
      }
    },
    "travel.order.exposure-resolved": {
      "type": "object",
      "required": [
        "orderId",
        "tripId",
        "exposureId",
        "resolvedBy",
        "resolution"
      ],
      "additionalProperties": false,
      "properties": {
        "orderId": {
          "$ref": "common.schema.json#/$defs/orderId"
        },
        "tripId": {
          "$ref": "common.schema.json#/$defs/tripId"
        },
        "exposureId": {
          "type": "string",
          "pattern": "^exp_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "resolvedBy": {
          "$ref": "common.schema.json#/$defs/principal"
        },
        "resolution": {
          "type": "string",
          "maxLength": 2000
        },
        "amount": {
          "$ref": "common.schema.json#/$defs/money"
        }
      }
    }
  }
}
