        "priority",
        "queue",
        "title",
        "nextAction",
        "nextActionRole",
        "escalationLevel",
        "dueAt",
        "closedBy"
      ],
      "additionalProperties": false,
      "properties": {
        "caseId": {
          "type": "string",
          "pattern": "^cas_[0-9A-HJKMNP-TV-Z]{26}$"
