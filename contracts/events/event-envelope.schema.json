{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.travelos.io/events/event-envelope.schema.json",
  "title": "EventEnvelope",
  "description": "Every event on every topic is wrapped in this envelope. No team invents its own.",
  "type": "object",
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "tenantId", "correlationId", "producer", "data"],
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "description": "ULID with evt_ prefix. Globally unique, time-sortable.",
      "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "eventType": {
      "type": "string",
      "description": "Dotted, lowercase. Topic = first two segments.",
      "pattern": "^travel\\.[a-z]+\\.[a-z_]+(\\.[a-z_]+)*$"
    },
    "eventVersion": { "type": "integer", "minimum": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "tenantId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "causationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "producer": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "data": { "type": "object" }
  }
}
